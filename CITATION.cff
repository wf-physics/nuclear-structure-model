    given-names: "Feng"
version: v1.0.0
date-released: "2026-11-25"
license: MIT
repository-code: "https://github.com/wf-physics/nuclear-structure-model"
keywords:
  - nuclear structure
  - nuclear matter
  - liquid drop model
  - alpha clustering
  - decay modes
